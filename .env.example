# Gateway Configuration
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
NODE_ENV=development

# Load Balancing Configuration
DEFAULT_ALGORITHM=round-robin
HEALTH_CHECK_INTERVAL_MS=2000
HEALTH_CHECK_TIMEOUT_MS=1000
UNHEALTHY_THRESHOLD=3
RECOVERY_THRESHOLD=2

# Upstream Backend URLs (comma-separated or configured in registry)
BACKEND_SERVERS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Backend Services
SERVER_1_PORT=3001
SERVER_2_PORT=3002
SERVER_3_PORT=3003

# SQLite Database
DATABASE_PATH=./data/gateway.sqlite

# Frontend
VITE_GATEWAY_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080
